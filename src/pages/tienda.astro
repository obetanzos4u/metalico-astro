---
import Layout from "../layouts/Layout.astro";
import { getCollectionProducts } from "../lib/shopify.js";

const storeDomain = import.meta.env.PUBLIC_SHOPIFY_STORE_DOMAIN;
const COLLECTION_ID = "504475058479";
const products = await getCollectionProducts(COLLECTION_ID, 100);

function formatPrice(amount, currency) {
  const value = parseFloat(amount);
  return new Intl.NumberFormat("es-MX", {
    style: "currency",
    currency,
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  }).format(value);
}

const tagCounts = new Map();
for (const p of products) {
  for (const t of p.tags ?? []) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="Tienda — Metalico" description="Explora nuestros productos manufacturados">
  <header class="flex items-center justify-between px-[5%] py-4 bg-metal-gray mb-6">
    <a href="/" onclick="event.preventDefault(); history.back()" class="flex items-center gap-2 text-sm font-medium text-gray-200 hover:text-white transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Volver al inicio
    </a>
    <h1 class="text-sm md:text-xl font-semibold text-white">Tienda Metalico</h1>
    <div class="w-20"></div>
  </header>

  <main class="max-w-7xl mx-auto px-4 pb-16">
    <div class="flex flex-col lg:flex-row gap-12 xl:gap-16">
      <div class="flex-1 min-w-0">
        <div class="flex justify-end mb-4">
          <select id="sort-select" class="text-sm border border-gray-300 rounded px-3 py-1.5 text-gray-700 bg-white cursor-pointer">
            <option value="default">Ordenar por</option>
            <option value="price-asc">Precio: menor a mayor</option>
            <option value="price-desc">Precio: mayor a menor</option>
            <option value="title-asc">Título: A - Z</option>
            <option value="title-desc">Título: Z - A</option>
          </select>
        </div>

    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {products.map((p) => {
        const price = p.priceRange.minVariantPrice;
        const image = p.images.edges[0]?.node;
        const variant = p.variants.edges[0]?.node;
        const shopUrl = `https://${storeDomain}/products/${p.handle}`;
        const desc = p.description ? p.description.slice(0, 90) + (p.description.length > 90 ? "…" : "") : "";
        return (
          <div
            class="product-card group border border-gray-100 rounded-lg overflow-hidden hover:shadow-md transition-shadow"
            data-price={price.amount}
            data-title={p.title.toLowerCase()}
            data-tags={(p.tags ?? []).map((t) => t.toLowerCase()).join(",")}
          >
            <a href={shopUrl} target="_blank" rel="noopener noreferrer" class="block">
              <div class="relative pt-[75%] bg-gray-50">
                {image && (
                  <img
                    src={image.url}
                    alt={image.altText || p.title}
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="lazy"
                  />
                )}
              </div>
            </a>
            <div class="p-3 flex flex-col gap-1.5">
              {p.productType && (
                <span class="text-[10px] uppercase tracking-wider text-yellow-600 font-semibold">{p.productType}</span>
              )}
              <a href={shopUrl} target="_blank" rel="noopener noreferrer">
                <h3 class="text-sm text-gray-800 font-semibold line-clamp-2 hover:text-yellow-600 transition-colors">{p.title.split(' ').slice(2).join(' ') || p.title}</h3>
              </a>
              {desc && (
                <p class="text-xs text-gray-500 line-clamp-2">{desc}</p>
              )}
              <div class="flex items-center gap-2 mt-0.5">
                {variant?.compareAtPrice && parseFloat(variant.compareAtPrice.amount) > parseFloat(price.amount) && (
                  <span class="text-xs text-gray-500"><span class="line-through">{formatPrice(variant.compareAtPrice.amount, variant.compareAtPrice.currencyCode)}</span> <span class="text-[0.5rem]">{variant.compareAtPrice.currencyCode}</span></span>
                )}
                <p class="text-base font-bold flex items-center gap-1" style="color:#ff8308">
                  {formatPrice(price.amount, price.currencyCode)}
                  <span class="text-[0.5rem] font-medium text-orange-400">{price.currencyCode}</span>
                </p>
              </div>
              {variant?.sku && (
                <span class="text-[10px] text-gray-500">SKU: {variant.sku}</span>
              )}
              <a
                href={shopUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-gray mt-1 inline-block w-full text-center border-[2px] border-metal-gray bg-metal-gray text-sm rounded font-medium text-white px-4 py-2 opacity-0 group-hover:opacity-100 transition-all hover:bg-yellow-300 hover:text-black hover:scale-[1.02]"
              >
                Comprar
              </a>
              {!p.availableForSale && (
                <span class="block text-center text-xs text-red-500">Agotado</span>
              )}
            </div>
          </div>
        );
      })}
    </div>

    {products.length === 0 && (
      <p class="text-center text-gray-500 py-16">No hay productos disponibles en este momento.</p>
    )}

    <p id="no-matches" class="hidden text-center text-gray-500 py-16">
      No hay productos que cumplan con los criterios seleccionados.
    </p>
    </div>

    <aside class="w-full lg:w-72 lg:shrink-0 lg:self-start lg:border-l lg:border-slate-200 lg:pl-6">
      <details
        id="filter-details"
        class="rounded-xl border border-slate-200 bg-white overflow-hidden"
      >
        <summary
          class="cursor-pointer list-none flex items-center justify-between px-4 py-3 bg-slate-50 font-semibold text-sm text-slate-800 select-none lg:pointer-events-none lg:cursor-default"
        >
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18l-7 8v6l-4 2v-8L3 4z"/></svg>
            Filtrar por etiqueta
          </span>
          <span id="filter-count" class="text-[11px] font-normal text-slate-500 lg:hidden">▼</span>
          <span id="filter-count-desk" class="text-[11px] font-normal text-slate-500 hidden lg:inline"></span>
        </summary>
        <div class="px-4 py-3 space-y-2 border-t border-slate-100">
          <p class="text-[11px] text-slate-400">Los productos deben cumplir todos los tags seleccionados</p>
          {allTags.map(([t, count]) => (
            <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
              <input
                type="checkbox"
                value={t.toLowerCase()}
                class="tag-check h-4 w-4 rounded border-slate-300 focus:ring-[#ff8308]"
                style="accent-color:#ff8308"
              />
              <span class="flex-1">{(t.charAt(0).toUpperCase() + t.slice(1).toLowerCase()).replace(/\bd\b/g, "D")}</span>
              <span class="text-xs text-slate-400">({count})</span>
            </label>
          ))}
          {allTags.length === 0 && (
            <p class="text-xs text-slate-400">No hay etiquetas disponibles.</p>
          )}
        </div>
      </details>
    </aside>
  </div>
  </main>

  <button id="btn-subir" class="fixed bottom-10 right-8 z-50 bg-yellow-400 text-black w-12 h-12 rounded-full shadow-lg flex items-center justify-center text-2xl font-bold transition-all duration-300 hover:bg-yellow-300 hover:scale-110 opacity-0 pointer-events-none" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" aria-label="Volver arriba">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3" stroke-linecap="round"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

  <footer class="text-desc bg-metal-gray">
    <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h3 class="text-white font-semibold text-lg mb-3">Métodos de pago</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block"></span>Tarjetas de débito / crédito (Visa, MasterCard)</li>
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block"></span>Transferencia bancaria / SPEI</li>
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block"></span>PayPal</li>
          <li class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block"></span>Pago en tienda (previo acuerdo)</li>
        </ul>
        <p class="text-xs text-desc mt-2">* Los métodos disponibles se confirmarán al finalizar la compra.</p>
      </div>
      <div>
        <h3 class="text-white font-semibold text-lg mb-3">Políticas de compra</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>Los precios pueden variar sin previo aviso.</li>
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>Las compras se procesan a través de Shopify, plataforma segura.</li>
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>Facturación: envía tu solicitud a contacto@metalico.mx.</li>
        </ul>
      </div>
      <div>
        <h3 class="text-white font-semibold text-lg mb-3">Envíos</h3>
        <ul class="space-y-2 text-sm">
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>Envío a toda la República Mexicana.</li>
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>Tiempo estimado de entrega: 3–5 días hábiles en productos con existencias.</li>
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>El costo de envío se calcula al momento del pago.</li>
          <li class="flex items-start gap-2"><span class="w-2 h-2 bg-yellow-400 rounded-full inline-block mt-1.5 shrink-0"></span>Recogida en taller disponible (previa cita).</li>
        </ul>
      </div>
      <div>
        <h3 class="text-white font-semibold text-lg mb-3">Contacto</h3>
        <ul class="space-y-2 text-sm">
          <li><span class="block text-desc text-xs">Correo</span><a href="mailto:contacto@metalico.mx" class="hover:text-white transition-colors underline underline-offset-2">contacto@metalico.mx</a></li>
          <li><span class="block text-desc text-xs">Teléfono</span><a href="tel:+525581082193" class="hover:text-white transition-colors underline underline-offset-2">55 8108 2193</a></li>
          <li><span class="block text-desc text-xs">WhatsApp</span><a href="https://wa.me/525581082193" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors underline underline-offset-2">55 8108 2193</a></li>
        </ul>
        <div class="mt-4">
          <a href="/privacidad" class="text-xs text-desc hover:text-white underline transition-colors">Política de privacidad</a>
        </div>
      </div>
    </div>
    <div class="border-t border-gray-800">
      <p class="text-center text-xs text-desc py-4">&copy; 2026 Metalico. Todos los derechos reservados.</p>
    </div>
  </footer>
</Layout>

<script>
  const btn = document.getElementById('btn-subir');
  window.addEventListener('scroll', function () {
    if (window.scrollY > window.innerHeight * 0.5) {
      btn.classList.remove('opacity-0', 'pointer-events-none');
      btn.classList.add('opacity-100');
    } else {
      btn.classList.add('opacity-0', 'pointer-events-none');
      btn.classList.remove('opacity-100');
    }
  });

  const sortSelect = document.getElementById("sort-select");
  const grid = document.getElementById("product-grid");
  const noMatches = document.getElementById("no-matches");
  const checkboxes = Array.from(document.querySelectorAll(".tag-check"));
  const filterCount = document.getElementById("filter-count-desk");
  const cards = Array.from(grid.querySelectorAll(".product-card"));
  let order = "default";

  function selectedTags() {
    return checkboxes.filter((c) => c.checked).map((c) => c.value);
  }

  function cardMatches(card, tags) {
    if (!tags.length) return true;
    const cardTags = (card.dataset.tags || "").split(",").filter(Boolean);
    return tags.every((t) => cardTags.includes(t));
  }

  function applyFilter() {
    const tags = selectedTags();
    let visible = cards.filter((c) => cardMatches(c, tags));

    if (order !== "default") {
      visible = visible.slice().sort((a, b) => {
        if (order === "price-asc") {
          const pa = parseFloat(a.dataset.price);
          const pb = parseFloat(b.dataset.price);
          return pa - pb;
        }
        if (order === "price-desc") {
          const pa = parseFloat(a.dataset.price);
          const pb = parseFloat(b.dataset.price);
          return pb - pa;
        }
        const ta = a.dataset.title;
        const tb = b.dataset.title;
        return order === "title-asc"
          ? ta.localeCompare(tb, "es")
          : tb.localeCompare(ta, "es");
      });
    }

    cards.forEach((c) => c.classList.toggle("hidden", !visible.includes(c)));
    visible.forEach((c) => grid.appendChild(c));
    noMatches.classList.toggle("hidden", visible.length > 0);
    if (filterCount) {
      filterCount.textContent =
        tags.length > 0 ? `— ${visible.length} de ${cards.length}` : "";
    }
  }

  sortSelect?.addEventListener("change", function () {
    order = this.value;
    applyFilter();
  });

  checkboxes.forEach((cb) => cb.addEventListener("change", applyFilter));

  const details = document.getElementById("filter-details");
  const lgMq = window.matchMedia("(min-width: 1024px)");
  function syncDetails() {
    if (lgMq.matches) details.open = true;
  }
  syncDetails();
  lgMq.addEventListener("change", syncDetails);
</script>