---
import LetsTalk from "./LetsTalk.astro";
---

<LetsTalk
  title="Contáctanos"
  subtitle="Hablemos de tu próximo proyecto metalmecánico"
  color="white"
  id="contact"
  showFooterContent="true"
  mostrarFormulario={true}
>
  <div slot="footer" class="w-full border-t border-white/10 pt-4 pb-2 px-6">
    <div class="flex flex-wrap justify-center items-center gap-4">
      <img src="/visa.svg" alt="Visa" class="h-5 max-md:h-4" width="49" height="16" />
      <img src="/mastercard.svg" alt="Mastercard" class="h-6 max-md:h-4" width="30" height="24" />
      <img src="/amex.svg" alt="Amex" class="h-6 max-md:h-4" width="25" height="24" />
      <img src="/mercadopago.svg" alt="Mercado Pago" class="h-6 max-md:h-4" width="49" height="13" />
      <img src="/paypal.svg" alt="PayPal" class="h-6 max-md:h-4" width="83" height="20" />
      <img src="/spei.svg" alt="SPEI" class="h-5 max-md:h-4" width="53" height="16" />
      <img src="/paquetexpress.svg" alt="Paquetexpress" class="h-6 max-md:h-4" width="84" height="20" />
      <img src="/estafeta.svg" alt="Estafeta" class="h-5 max-md:h-4" width="57" height="11" />
    </div>
    <div class="flex flex-wrap justify-center gap-x-8 gap-y-1 text-xs text-white/80 mt-3">
      <span>CDMX, México</span>
      <span>Hecho con &#x1FA76; por Metalico - 2026</span>
      <span>Precios en pesos mexicanos MXN</span>
    </div>
  </div>
  <img
    slot="background"
    alt=""
    class="h-full w-full object-cover object-center"
    src="bg-steel-black.avif"
    id="bg-image-contact"
  />
</LetsTalk>
<script>
  let imageElement = document.querySelector(
    "#bg-image-contact",
  ) as HTMLImageElement;

  imageElement.src = "contact-bg.avif";
</script>
