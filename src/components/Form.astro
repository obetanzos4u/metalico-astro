---
const emailjsPublicKey =
  import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY || "SsrXxV23cwZnkbb0C";
const emailjsServiceId =
  import.meta.env.PUBLIC_EMAILJS_SERVICE_ID || "service_t2idvpt";
const emailjsTemplateId =
  import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID || "template_b4pxi59";
---

<div class="container-form">
  <form
    id="form"
    class="min-h-0 sm:min-h-0 md:min-h-80 lg:min-h-80 xl:min-h-80 2xl:min-h-80"
    data-emailjs-public-key={emailjsPublicKey}
    data-emailjs-service-id={emailjsServiceId}
    data-emailjs-template-id={emailjsTemplateId}
  >
    <div id="form__inputs">
      <div class="tab__content mod--contact">
        <div
          id="w-node-key"
          class="w-layout-layout stack mod--contact-form wf-layout-layout"
        >
          <div class="field w-layout-cell">
            <div class="input-wrap">
              <label
                class="form__label absolute activeFocusLabel"
                for="from_name"
                >Nombre
                <span class="text-color-red">*</span>
              </label>
              <input
                type="text"
                name="from_name"
                id="from_name"
                class="input w-input activeFocusInput"
              />
            </div>
          </div>
          <div class="field w-layout-cell">
            <div class="input-wrap">
              <label
                class="form__label absolute activeFocusLabel"
                for="user_email"
                id="email_label"
                >Correo electrónico
                <span class="text-color-red">*</span>
              </label>
              <input
                type="email"
                name="user_email"
                id="user_email"
                class="input w-input activeFocusInput"
              />
              <div class="form__label-invalid anim">
                Por favor, proporciones un correo válido
              </div>
            </div>
          </div>
          <div class="field w-layout-cell">
            <div class="input-wrap">
              <label
                class="form__label absolute activeFocusLabel"
                for="telephone"
                >Teléfono
                <span class="text-color-red">*</span>
              </label>
              <input
                type="text"
                name="telephone"
                id="telephone"
                class="input w-input activeFocusInput"
              />
            </div>
          </div>
          <div class="field w-layout-cell">
            <div class="input input-wrap" style="z-index:100;">
              <div
                class="form-dropdown_toggle w-dropdown-toggle w-dropdown h-full"
              >
                <div
                  class="flex justify-between items-center w-toggle-arrow"
                  style="height: 100%;"
                >
                  <label
                    id="service_type_label"
                    class="form-dropdown__toggle-title text-start g-12"
                    for="service_type"
                  >
                    Tipo de servicio
                  </label>
                  <img
                    id="img-arrow"
                    class="form-dropdown__toggle-arrow"
                    style="right: 0; position: absolute; z-index: -1;"
                    src="/dropdown-arrow.png"
                    alt=""
                  />
                </div>
                <select name="service_type" id="service_type" class="hidden">
                  <option value="metal_cutting">Cortes de metal</option>
                  <option value="plastic_injection"
                    >Inyección de plástico</option
                  >
                  <option value="metal_casting">Fundición de metales</option>
                  <option value="metal_painting">Pintado de metales</option>
                  <option value="product_development"
                    >Desarrollo de productos</option
                  >
                  <option value="parts_assembly">Unión de piezas</option>
                </select>
              </div>
            </div>
          </div>
          <!-- Campo para ingresar texto -->
          <div id="proyect_form" class="field w-layout-cell">
            <div class="input-wrap is-textarea-contacts">
              <label class="form__label absolute activeFocusLabel" for="message"
                >Acerca de tu proyecto
                <span class="text-color-red">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                placeholder=""
                class="input w-input activeFocusInput w-full"
                style="height: 8rem; padding-top: 1rem;"
                rows="4"
                cols="50"></textarea>
              <!-- <input
                type="text"
                id="message"
                name="message"
                placeholder=""
                class="input w-input activeFocusInput w-full"
                style="border-bottom: 0; height: 8rem;"
              /> -->
              <!-- Campo para subir archivos -->
              <label
                for="archivo"
                class="custom-file-upload input w-input size-full justify-end"
                style="height: 2rem; border-bottom: 0; margin-top: -2rem"
              >
                <img src="/attachment-icon.png" alt="Icono de archivo" />
                <span id="nombreArchivo" class="file-name">Selecciona tu archivo</span>
              </label>
              <input
                type="file"
                id="archivo"
                name="archivo"
                accept="*/*"
                class=""
                style="display: none;"
              />
              <p id="wordCount" class="count-text g-12">0 / 350 caracteres</p>
            </div>
          </div>
        </div>
        <div class="input-wrap mod--contact-submit-step1">
          <div class="policy-privacy text-left">
            <span
              >Al enviar este formulario confirmo que he leído y acepto la <a
                href="/privacidad"
                class="link-color">Política de Privacidad</a
              >
            </span>
          </div>
          <div class="form-submit-wrap">
            <button
              type="button"
              id="button"
              class="button"
              >Enviar un mensaje
              <div class="button__icons is-white">
                <div class="icon-small w-embed">
                  <svg
                    aria-hidden="true"
                    role="img"
                    fill="currentColor"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    width="100%"
                    height="100%"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3.5 8a1 1 0 0 1 1-1h4a1 1 0 0 1 0 2h-4a1 1 0 0 1-1-1Z"
                      clip-rule="evenodd"></path>
                    <path
                      fill-rule="evenodd"
                      d="M14.216 6.693a1.494 1.494 0 0 1 0 2.615L3.664 15.222a1.5 1.5 0 0 1-2.148-1.823L3.447 8l-1.93-5.398A1.5 1.5 0 0 1 3.662.779l10.553 5.914ZM12.458 8 3.845 3.173l1.545 4.32c.119.328.119.687 0 1.015l-1.545 4.32L12.457 8Z"
                      clip-rule="evenodd"></path>
                  </svg>
                </div>
              </div>
            </button>
          </div>
        </div>
        <div id="form-message"></div>
      </div>
    </div>
    <div id="form__sucess"></div>
  </form>
</div>

<style>
  :root {
    --blue: #3719ca;
    --white: #fff;
    --blue-dark: #02021e;
  }

  @view-transition {
    navigation: auto; /* ¡Habilitado! */
  }

  .field {
    margin-bottom: 6px;
  }

  .hidden {
    display: none;
  }

  .select-visible {
    display: block;
  }

  .link-color {
    color: var(--blue);
    text-decoration: underline;
  }

  textarea {
    resize: none;
  }

  input {
    width: 100%;
  }
  input[type="file"] {
    color: transparent;
  }
  input[type="file"]::after {
    content: "Selecciona tu archivo";
  }
  .file-name {
    color: #5d5d68;
    font-size: 12px;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .field input {
    display: block;
    width: 100%;
    min-width: 0;
    line-height: 1.5;
    font-size: 14px;
  }

  .text-color-red {
    color: rgb(214, 18, 18);
  }
  .custom-file-upload {
    display: flex;
    cursor: pointer;
  }
  .custom-file-upload img {
    /* Estilos para tu imagen, por ejemplo: */
    width: 26px; /* Ancho de la imagen */
    height: 26px; /* Alto de la imagen */
  }
  .tab__content.mod--contact {
    flex-direction: column;
    justify-content: space-between;
    min-height: 25.1rem;
    display: flex;
  }

  .container-form {
    border-radius: 8px;
    padding: 0.5rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .container-form {
      padding: 1rem 1.25rem;
    }
  }

  .w-input::placeholder,
  .w-select::placeholder {
    color: #999;
    opacity: 1;
  }
  .input {
    color: var(--blue-dark);
    background-color: transparent;
    border: 0 solid #32344d;
    border-bottom: 0.0625rem solid rgba(2, 2, 30, 0.2);
    border-radius: 0;
    height: 3.5rem;
    margin-bottom: 0;
    padding: 0;
    font-size: 1rem;
    transition: all 0.2s;
    position: relative;
  }

  .input:focus {
    border-bottom-color: var(--blue);
    outline: 0;
  }

  .form-dropdown__toggle-title {
    color: #44445a !important;
  }
  .form-dropdown__toggle {
    color: #02021e;
    border-bottom: 1px solid rgba(2, 2, 30, 0.2);
    justify-content: space-between;
    align-items: center;
    height: 3.5rem;
    padding: 0;
    transition: all 0.2s;
    display: flex;
  }

  .form-dropdown__toggle-arrow {
    width: 1rem;
    height: 1rem;
    position: relative;
    display: inline-block;
    transform: rotate(0);
  }

  .stack {
    grid-column-gap: 1rem;
    grid-row-gap: 1rem;
    padding: 0;
  }

  .w-layout-layout {
    grid-row-gap: 20px;
    grid-column-gap: 20px;
    grid-auto-columns: 1fr;
    justify-content: center;
  }

  .wf-layout-layout {
    display: grid;
  }

  form {
    max-width: 100%;
    box-sizing: border-box;
  }

  .count-text {
    width: fit-content;
    font-size: 0.835rem;
    margin-right: 0;
    margin-left: auto;
    color: #44445a !important;
  }
  .policy-privacy {
    color: rgba(2, 2, 30, 0.7);
    width: 100%;
    max-width: 100%;
    font-size: 0.835rem;
  }
  .button {
    z-index: 2;
    grid-column-gap: 0.75rem;
    background-color: var(--blue);
    color: #fff;
    text-align: center;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 99px;
    justify-content: center;
    align-items: center;
    padding: 1.1rem 0.75rem 1.1rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    transition: all 0.4s;
    display: flex;
    position: relative;
    transform: translate(0);
  }
  .button:hover {
    background-color: #2e15a0;
    transform: scale(1.02);
  }
  .button:hover .button__icons.is-white {
    background-color: #2e15a0;
    border-color: #fff;
  }
  .button:hover .button__icons.is-white svg {
    fill: #fff;
  }
  .icon-small {
    z-index: 2;
    flex: none;
    width: 1rem;
    height: 1rem;
    font-size: 0;
    position: relative;
  }

  .w-layout-cell {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    display: flex;
  }

  .input-wrap.mod--contact-submit-step1 {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .policy-privacy {
    width: 100%;
    max-width: 100%;
  }

  .form-submit-wrap {
    align-self: flex-end;
  }

  .input-wrap {
    z-index: 1;
    width: 100%;
    position: relative;
    transform: translate(0);
  }

  .stack.mod--contact-form {
    grid-column-gap: 2rem;
    grid-row-gap: 2rem;
    margin-bottom: 0;
  }
  .button__icons.is-white {
    border-color: var(--white);
    background-color: var(--white);
    color: var(--blue);
    position: relative;
  }

  .button__icons {
    color: #fff;
    background-color: #3827c7;
    border: 0.125rem solid #3827c7;
    border-radius: 50%;
    flex: none;
    justify-content: center;
    align-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: -1rem;
    margin-bottom: -1rem;
    transition: all 0.4s;
    display: flex;
    position: relative;
    overflow: hidden;
    transform: translate(0);
  }

  .select-visible {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    margin-top: 0.5rem;
    z-index: 1000;
    background-color: white;
    border: 1px solid #ccc;
  }
  .form__label.active {
    font-size: 0.875rem;
    transform: translateY(-0.2rem);
  }
  .form__label,
  .form__label-invalid {
    pointer-events: none;
  }
  .form__label {
    z-index: 2;
    color: rgba(2, 2, 30, 0.7) !important;
    font-size: 1rem;
    margin-bottom: 0;
    margin-left: -0.25rem;
    padding-left: 0.25rem;
    padding-right: 0.25rem;
    font-weight: 400;
    line-height: 1;
    transition: all 0.3s cubic-bezier(0.215, 0.61, 0.355, 1);
    /* position: absolute; */
    top: 0;
    left: 0%;
    right: auto;
    transform: translateY(1.4rem);
  }

  .form__label-invalid.anim {
    position: absolute;
    opacity: 0;
    transform: translateY(-0.5rem);
  }

  .form__attach {
    grid-column-gap: 0.75rem;
    grid-row-gap: 0.75rem;
    pointer-events: none;
    justify-content: flex-end;
    align-items: center;
    margin-top: 1rem;
    margin-bottom: 1rem;
    display: flex;
  }
  .w--open #img-arrow {
    transform: rotate(-180deg);
    transition: transform 200ms ease;
  }

  div.w--open {
    border-bottom: 1px solid #3827c7;
  }

  #w-node-key {
    grid-template-rows: auto;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    #w-node-key {
      grid-template-columns: 1fr 1fr;
    }
    #proyect_form {
      grid-column: span 2;
    }
  }
  .g-12 {
    color: rgba(2, 2, 30, 0.8);
  }
  .selected-option {
    color: black !important;
  }

  .form-message {
    text-align: center;
    font-size: 0.9rem;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    display: none;
  }

  .form-message.success {
    display: block;
    color: #166534;
    background-color: #dcfce7;
  }

  .form-message.error {
    display: block;
    color: #991b1b;
    background-color: #fee2e2;
  }
</style>

<script>
  const form = document.getElementById("form");

  if (form) {
    const loadFormScript = () => import("../scripts/contact-form.js");
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          observer.disconnect();
          loadFormScript();
        }
      },
      { rootMargin: "400px 0px" },
    );
    observer.observe(form);
  }
</script>
