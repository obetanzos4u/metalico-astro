<style>
  :root {
    --blue-dark: #02021e;
    --yellow: #fdc448;
  }
  .custom-info-contact {
    display: flex;
    width: fit-content;
    grid-column-gap: 2.75rem;
    grid-row-gap: 2.75rem;
    opacity: 1;
    flex-direction: column;
    flex: 0 auto;
    justify-content: flex-start;
    padding-top: 2rem;
    justify-content: space-between;
    transition: opacity 0.4s;
  }

  .heading-1 {
    width: fit-content;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    font-size: 3rem;
    text-align: left;
    font-weight: 500;
    line-height: 0.9;
  }

  @media (min-width: 780px) and (max-width: 1279px) {
    .heading-1 {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .custom-info-contact {
      display: contents;
    }
    .heading-1 {
      font-size: 24px;
      display: none;
    }
    .custom-info-contact .contact__list-wrap {
      display: none;
    }
    .columns .contact__video-address {
      flex-flow: column;
    }
    .columns.mod--contact-video {
      margin: auto;
    }
    .custom-info-contact .contact-title {
      font-size: 0.75rem;
    }
    .custom-info-contact .contact-mail {
      font-size: 1rem;
    }
    .custom-info-contact .contact-info-wrap {
      margin-left: 0rem;
      margin-top: 1rem;
    }
  }

  @media (min-width: 1280px) {
    .heading-1 {
      font-size: 5rem;
    }
  }

  .contact__list-wrap {
    grid-column-gap: 4.75rem;
    grid-row-gap: 4.75rem;
    flex-direction: column;
    align-items: center;
    display: flex;
  }
  .list__item {
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .list__item {
      font-size: 1.25rem;
    }
  }
  .contact-title {
    text-transform: uppercase;
    opacity: 0.7;
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .list__item.mod--contact {
    opacity: 1;
    background-image: url("/bullet-icon.png");
    background-position: 0%;
    background-repeat: no-repeat;
    background-size: 1.25rem;
    text-align: initial;
    margin-bottom: 0;
    padding-left: 2rem;
    list-style-type: none;
    transition:
      transform 0.6s,
      opacity 0.4s;
    position: relative;
    transform: translate(0);
  }
  .columns {
    justify-content: space-between;
    align-items: stretch;
    display: flex;
  }

  .list.mod--contact {
    grid-column-gap: 0.875rem;
    grid-row-gap: 0.875rem;
    flex-direction: column;
    padding-left: 0;
    display: flex;
  }
  .contact-mail {
    font-size: 1.25rem;
    font-weight: 500;
    text-align: initial;
  }
  .columns.mod--contact-video {
    grid-column-gap: 1.5rem;
    opacity: 1;
    justify-content: flex-start;
    align-items: center;
    transition:
      transform 0.6s,
      opacity 0.4s;
    transform: translate(0);
  }
  .columns__col.mod--contact-video {
    grid-row-gap: 1.25rem;
    flex-direction: column;
    flex: 0 auto;
    justify-content: center;
    align-items: flex-start;
    display: flex;
  }
  .contact__video-address {
    grid-column-gap: 1rem;
    flex-flow: row;
    align-items: center;
    display: flex;
  }

  .contact-info-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-left: 1rem;
  }

  .contact-video {
    width: 160px;
    height: auto;
    flex-shrink: 0;
    display: block;
  }
  .contact-video-el {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }
  .contact-mail-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    color: inherit;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
  }
  .copy-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.8);
  }
  .copy-feedback {
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7rem;
    white-space: nowrap;
    background: var(--yellow);
    color: var(--blue-dark);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .copy-feedback.is-showing {
    opacity: 1;
  }
</style>

<script>
  const el = document.querySelector('.hf-frame');
  if (el) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          el.classList.add('is-visible');
        } else {
          el.classList.remove('is-visible');
        }
      });
    }, { threshold: 0.3 });
    observer.observe(el);
  }
</script>

<script>
  const copyBtn = document.querySelector("#copy-email-btn");
  const emailEl = document.querySelector(".contact-mail");
  const feedback = document.querySelector("#copy-feedback");
  if (copyBtn && emailEl) {
    copyBtn.addEventListener("click", async () => {
      const email = emailEl.textContent.trim();
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = email;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        document.body.removeChild(ta);
      }
      if (feedback) {
        feedback.classList.add("is-showing");
        setTimeout(() => feedback.classList.remove("is-showing"), 2000);
      }
    });
  }
</script>
