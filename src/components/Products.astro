---
import { getProductsByHandles } from "../lib/shopify.js";

const storeDomain = import.meta.env.PUBLIC_SHOPIFY_STORE_DOMAIN;

const productHandles = [
  "portabobinas-en-vertical-para-cable-drop-marca-metalico-pbvcd0724x24",
  "soporte-para-bobinas-7-toneladas-ajustable-marca-metalico-sopb05-07p",
  "polea-para-cable-marca-metalico-pol305a",
  "grapa-reunidora-tipo-o-40-x-100-mm-marca-metalico-gro40x100",
];

const shopProducts = await getProductsByHandles(productHandles);

const categorias = shopProducts.map((p) => {
  const img = p.images?.edges?.[0]?.node?.url ?? "";
  return {
    titulo: p.title.split(' ').slice(2).join(' ') || p.title,
    tipos: p.description ? [p.description.slice(0, 100)] : [],
    img,
    link: `https://${storeDomain}/products/${p.handle}`,
  };
});
---

<section
  id="products"
  class="landing-section relative min-h-screen w-screen flex flex-col items-center justify-center text-white"
  data-header-color="white"
>
  <div class="absolute inset-0 h-full w-full z-0">
    <img class="h-full w-full object-cover object-center" src="products.avif" alt="" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/60 to-black/80"></div>
  </div>

  <div class="relative z-10 w-full max-w-6xl mx-auto px-6 py-16 flex flex-col items-center">
    <h2 class="text-2xl md:text-5xl font-bold text-white mb-2">Productos</h2>
    <p class="slide-desc text-desc mb-10 text-center max-w-xl">
      Equipamiento para redes de telecomunicaciones e infraestructura industrial
    </p>

    <div class="slide-content grid grid-cols-2 md:grid-cols-4 gap-4 max-md:w-[90%]">
      {categorias.map((cat) => (
        <div class="group relative overflow-hidden rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20 transition-all duration-300 hover:scale-[1.03] hover:bg-white/20">
          <div class="aspect-[5/5] overflow-hidden">
            <img
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
              src={cat.img}
              alt={cat.titulo}
            />
          </div>
          <div class="p-4 flex flex-col gap-1.5">
            <h3 class="text-sm md:text-base font-semibold leading-tight">{cat.titulo}</h3>
            <ul class="text-xs text-desc space-y-0.5">
              {cat.tipos.map((t) => <li class="before:content-['-'] before:mr-1.5 before:text-yellow-400">{t}</li>)}
            </ul>
            {cat.link ? (
              <a
                href={cat.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs uppercase tracking-wider text-yellow-400 hover:text-yellow-300 transition-colors font-medium pt-1 inline-block"
              >
                Ver más &rarr;
              </a>
            ) : null}
          </div>
        </div>
      ))}
    </div>

    <a
      href="/tienda"
      class="btn-gray mt-8 inline-block border-[3px] border-stone-600 bg-stone-600 text-sm rounded font-medium text-white w-64 text-center py-2.5 transition-all hover:bg-yellow-400 hover:text-black hover:scale-[1.02]"
    >
      Ir a tienda &rarr;
    </a>
  </div>
</section>

<style>
  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .grid > div:nth-child(n+3) {
      display: none;
    }
  }
</style>
